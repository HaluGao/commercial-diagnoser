{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commercial_diagnoser/fact_pack.schema.json",
  "title": "Commercial Diagnoser Fact Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "project_name",
    "input_files",
    "pages",
    "recognized_elements",
    "derived_facts",
    "uncertainties"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "input_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "file_type"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "file_type": {
            "type": "string",
            "enum": [
              "pdf",
              "image"
            ]
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_index",
          "page_label",
          "text_blocks",
          "visual_regions"
        ],
        "properties": {
          "page_index": {
            "type": "integer",
            "minimum": 0
          },
          "page_label": {
            "type": "string"
          },
          "text_blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "confidence"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "bbox": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "visual_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "region_id",
                "region_type",
                "summary"
              ],
              "properties": {
                "region_id": {
                  "type": "string"
                },
                "region_type": {
                  "type": "string",
                  "enum": [
                    "plan",
                    "elevation",
                    "section",
                    "rendering",
                    "table",
                    "diagram",
                    "photo",
                    "unknown"
                  ]
                },
                "summary": {
                  "type": "string"
                },
                "bbox": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "recognized_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element_id",
          "element_type",
          "description"
        ],
        "properties": {
          "element_id": {
            "type": "string"
          },
          "element_type": {
            "type": "string",
            "enum": [
              "main_entry",
              "secondary_entry",
              "atrium",
              "escalator",
              "anchor_store",
              "void_space",
              "circulation",
              "facade",
              "feature_space",
              "parking",
              "vertical_core",
              "unknown"
            ]
          },
          "description": {
            "type": "string"
          },
          "page_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "region_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "derived_facts": {
      "type": "array",
      "description": "Higher-level facts inferred from the parsed inputs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "topic",
          "statement",
          "supporting_evidence"
        ],
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "page_index",
                "region_id",
                "reason"
              ],
              "properties": {
                "page_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "region_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "reason"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "recommended_followup": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}

