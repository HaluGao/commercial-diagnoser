{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commercial_diagnoser/diagnosis_report.schema.json",
  "title": "Commercial Diagnoser Diagnosis Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "project_info",
    "executive_summary",
    "issues",
    "optimizations",
    "citations"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "project_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_name",
        "input_types"
      ],
      "properties": {
        "project_name": {
          "type": "string"
        },
        "input_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pdf",
              "image"
            ]
          }
        },
        "asset_mix": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mall",
              "apartment",
              "hotel",
              "office",
              "commercial_street",
              "mixed_use",
              "unknown"
            ]
          },
          "default": []
        }
      }
    },
    "executive_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_view",
        "key_strengths",
        "key_risks"
      ],
      "properties": {
        "overall_view": {
          "type": "string"
        },
        "key_strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnosisItem"
      }
    },
    "optimizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnosisItem"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citation_id",
          "source_type",
          "source_file",
          "source_locator",
          "quoted_or_paraphrased_text"
        ],
        "properties": {
          "citation_id": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "source_file": {
            "type": "string"
          },
          "source_locator": {
            "type": "string"
          },
          "quoted_or_paraphrased_text": {
            "type": "string"
          }
        }
      }
    },
    "appendix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "image_id",
              "caption"
            ],
            "properties": {
              "image_id": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "diagnosisItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "title",
        "category_l1",
        "category_l2",
        "finding_type",
        "basis_type",
        "severity",
        "summary",
        "evidence_refs",
        "rule_refs",
        "recommendation"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "category_l1": {
          "type": "string"
        },
        "category_l2": {
          "type": "string"
        },
        "finding_type": {
          "type": "string",
          "enum": [
            "error",
            "optimization"
          ]
        },
        "basis_type": {
          "type": "string",
          "enum": [
            "group_standard",
            "general_principle"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "summary": {
          "type": "string"
        },
        "detailed_analysis": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page_index",
              "region_id",
              "description"
            ],
            "properties": {
              "page_index": {
                "type": "integer",
                "minimum": 0
              },
              "region_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "rule_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "recommendation": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
