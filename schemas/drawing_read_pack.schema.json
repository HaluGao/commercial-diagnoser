{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commercial_diagnoser/drawing_read_pack.schema.json",
  "title": "Commercial Diagnoser Drawing Read Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "project_name",
    "page_reads",
    "cross_page_understanding",
    "confirmed_points",
    "inferred_points",
    "open_questions"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "page_reads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_index",
          "page_label",
          "page_type",
          "read_summary",
          "key_objects",
          "key_relations"
        ],
        "properties": {
          "page_index": {
            "type": "integer",
            "minimum": 0
          },
          "page_label": {
            "type": "string"
          },
          "page_type": {
            "type": "string",
            "enum": [
              "cover",
              "site_plan",
              "basement_plan",
              "floor_plan",
              "elevation",
              "section",
              "rendering",
              "mixed_board",
              "unknown"
            ]
          },
          "read_summary": {
            "type": "string"
          },
          "key_objects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key_relations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "cross_page_understanding": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "statement",
          "supporting_pages"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "supporting_pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "confirmed_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inferred_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "reason"
        ],
        "properties": {
          "statement": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

